# OpenShell release the smoke test runs against. smoke.sh downloads these assets
# from https://github.com/NVIDIA/OpenShell/releases/download/<version>/ and
# refuses any file whose SHA-256 differs. Update every line together.
OPENSHELL_VERSION=v0.1.7
OPENSHELL_COMMIT=5d25211b25a8fc887e8d5c606d57d6ab22f1d76c
# Runtime images the gateway launches, pinned to the multi-arch manifest-list
# digest of the release tag (docker buildx imagetools inspect <image>:0.1.7).
OPENSHELL_SUPERVISOR_IMAGE=ghcr.io/nvidia/openshell/supervisor@sha256:a07864bd0c546716039c2000a919f50ce8f7f1f67ba37dda350cf64d3a7cfb06
OPENSHELL_SANDBOX_IMAGE=ghcr.io/nvidia/openshell/sandbox@sha256:89819c03f291d9b909c3fc2962360e24af4516627422d18f3e681829f003f347
# openshell (CLI)
OPENSHELL_CLI_SHA256_x86_64_unknown_linux_musl=5c1adfcae797eac9b2e8b9280c66c1f75e4e84d9e31ce6938c5b994314ef6098
OPENSHELL_CLI_SHA256_aarch64_unknown_linux_musl=696b523c263895b69eaa7c7e6afbb19b8af6c65cd79c7ffac7b685b6e3aa23da
OPENSHELL_CLI_SHA256_aarch64_apple_darwin=c5899a2fe6b40c371e7d660bd8983cefb766d04658bd9193b12a80525b12c742
# openshell-gateway
OPENSHELL_GATEWAY_SHA256_x86_64_unknown_linux_gnu=e1714dcfd85c949e2f53260bcfbf04b203f6f5cbd3a61e61c11c38cbc91cb102
OPENSHELL_GATEWAY_SHA256_aarch64_unknown_linux_gnu=eb0ba91efebbcc61e4cfae5fb18934c5fe308ece1a09ba16c999d00c452109dc
OPENSHELL_GATEWAY_SHA256_aarch64_apple_darwin=fe47a385c16c10cde8905bf1bf627e4a9fbf4a81bcf44b388dec4d22618fbb48
