# Live two-agent OpenShell demo — environment.
#
# Copy to `.env` (gitignored) and fill in. run-demo.sh sources this file and
# renders all configs from it, so this is the SINGLE source of truth.
#
#   cp deploy/live-demo/.env.example deploy/live-demo/.env   # then edit
#
# NOTHING here is committed with real values. The buyer identity is a
# disposable demo identity (no wallet); its private keys are shared out-of-band
# (a .env + the 3 PEM files), never through git. See SECRETS.md.

# ---- Paths ----------------------------------------------------------------
# WORK: scratch dir holding the OpenShell CLI, gateway PKI, rendered configs,
# and the materialized secrets. Must already contain bin/openshell + pki/.
WORK="$HOME/openshell-live"
# REPO: this repository checkout (for the Go binaries under ./bin).
REPO="$HOME/ans-openshell"
# HOST_IP: your WSL eth0 IP (ip route get 1.1.1.1 | awk '{print $7}').
HOST_IP="10.0.0.0"

# ---- Buyer agent (Agent A) — the registered, commerce-enabled identity ----
# PUBLIC identifiers (safe, but kept here so the repo carries no values):
BUYER_ANS_NAME="ans://vX.Y.Z.buyer.example.com"
BUYER_AGENT_ID="00000000-0000-0000-0000-000000000000"
# The 3 identity files (absolute paths). key.pem + commerce-dpop.pem are the
# PRIVATE keys the agent owner supplies out-of-band; cert.pem is public.
BUYER_KEY_FILE="$WORK/secrets/buyer/key.pem"
BUYER_CERT_FILE="$WORK/secrets/buyer/cert.pem"
BUYER_COMMERCE_DPOP_KEY="$WORK/secrets/buyer/commerce-dpop.pem"

# ---- Rogue agent (Agent B) — dev-mode, self-signed, no commerce -----------
ROGUE_ANS_NAME="ans://v9.9.9.rogue.example"
ROGUE_AGENT_ID="00000000-0000-0000-0000-000000000b0b"

# ---- Transparency log (GoDaddy production) --------------------------------
TL_BASE_URL="https://transparency.ans.godaddy.com"
TL_ROOT_KEYS_FILE="$WORK/tl-root-keys.txt"

# ---- Commerce (seller + authority the buyer transacts with) ---------------
SELLER_MCP_URL="https://seller.skybound-travel.com/mcp/"
AUTHORITY_MCP_URL="https://authority.skybound-travel.com/mcp/"
SELLER_ANS="ans://vX.Y.Z.seller.example.com"
AUTHORITY_ANS="ans://vX.Y.Z.authority.example.com"
SCOPE_HINT="purchase:flight:demo"
# subject_ans is normally the buyer's own ANS name:
SUBJECT_ANS="$BUYER_ANS_NAME"
DEMO_QUOTE_ID="demo-quote-001"
DEMO_AMOUNT="500"
DEMO_CURRENCY="USD"

# ---- Gateway / wiring (rarely changed) ------------------------------------
OPENSHELL_GATEWAY_ENDPOINT="https://127.0.0.1:17670"
EGRESS_A_LISTEN="0.0.0.0:50051"
EGRESS_B_LISTEN="0.0.0.0:50052"
INGRESS_PORT="50060"           # only used by the echo topology; unused here
MAX_PAYLOAD_BYTES="262144"
